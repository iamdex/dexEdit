<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only thing the app and the share extension share: a small hand-off
	     folder. Your notes are not in here — they are in the folder you chose,
	     which only the app can reach. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.espertini.dexEdit</string>
	</array>
</dict>
</plist>
